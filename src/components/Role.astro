---
// Un puesto. La columna izquierda es el dato de filtro (quien, donde, cuando);
// la derecha es el resultado y la historia.
interface Props {
  company: string;
  role: string;
  location: string;
  dates: string;
  tag?: string;
  first?: boolean;
}
const { company, role, location, dates, tag, first } = Astro.props;
---

<article
  class:list={[
    'grid grid-cols-1 gap-x-10 gap-y-5 border-t border-line pt-11 sm:grid-cols-12',
    first ? '' : 'mt-13 sm:mt-14',
  ]}
>
  <div class="sm:col-span-3">
    <h3 class="m-0 text-base font-semibold">{company}</h3>
    <p class="mt-1.5 mb-0 text-sm leading-relaxed text-muted">
      {role}<br />{location}<br />{dates}
    </p>
    {
      tag && (
        <p class="mt-3 mb-0 inline-block rounded bg-panel px-2 py-1 text-xs font-medium text-muted">
          {tag}
        </p>
      )
    }
  </div>
  <div class="prose sm:col-span-9">
    <slot />
  </div>
</article>
