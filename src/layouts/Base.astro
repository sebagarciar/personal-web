---
import '../styles/global.css';
import { ui, type Locale } from '../i18n/site';

interface Props {
  locale: Locale;
  title: string;
}
const { locale, title } = Astro.props;
const t = ui[locale];
const home = locale === 'en' ? '/' : '/es/';
const other = t.otherLocale === 'en' ? '/' : '/es/';

// Cloudflare Web Analytics. Paste the site token here to switch it on.
// Empty string means no beacon is loaded at all.
const analyticsToken = '1df71799831c4a9f9c2774c3021dc28a';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={t.metaDescription} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={new URL(home, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site)} />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:type" content="profile" />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-white focus:px-4 focus:py-2 focus:text-blue"
    >
      {t.skipToContent}
    </a>

    <header class="sticky top-0 z-20 border-b border-line bg-white">
      <div
        class="mx-auto flex w-full max-w-[76rem] flex-wrap items-center justify-between gap-x-5 gap-y-2 px-6 py-3.5 sm:gap-y-3 sm:px-10 sm:py-5 lg:px-16"
      >
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] font-medium sm:gap-x-8 sm:text-sm">
          {
            t.nav.map((item) => (
              <a href={item.href} class="text-muted hover:text-ink" data-ev={`nav:${item.href.slice(1)}`}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <nav class="flex items-center gap-4 text-[13px] font-medium sm:gap-7 sm:text-sm">
          <span class="text-ink" aria-current="true">{t.thisLocaleLabel}</span>
          <a
            href={other}
            class="text-muted hover:text-ink"
            hreflang={t.otherLocale}
            data-ev={`locale:${t.otherLocale}`}
          >
            {t.otherLocaleLabel}
          </a>
        </nav>
      </div>
    </header>

    <div class="mx-auto w-full max-w-[76rem] px-6 sm:px-10 lg:px-16">
      <main id="main" class="pt-12 sm:pt-16">
        <slot />
      </main>

      <footer class="border-t border-line py-10 text-sm text-muted">
        <p class="m-0">
          © {new Date().getFullYear()} Sebastián García Romero. Madrid.
        </p>
      </footer>
    </div>
    <script is:inline define:vars={{ analyticsToken }}>
      // Visits from Seba's own devices are excluded from analytics.
      // Visit /?me=1 once per device to opt out, /?me=0 to opt back in.
      (function () {
        var KEY = 'sg:no-analytics';
        var params = new URLSearchParams(location.search);

        if (params.has('me')) {
          var optOut = params.get('me') !== '0';
          try {
            if (optOut) localStorage.setItem(KEY, '1');
            else localStorage.removeItem(KEY);
          } catch (e) {
            // Storage blocked (private window). Nothing to persist.
          }
          // Strip the flag so a copied URL never opts a visitor out.
          params.delete('me');
          var query = params.toString();
          history.replaceState(
            null,
            '',
            location.pathname + (query ? '?' + query : '') + location.hash
          );
        }

        var excluded = false;
        try {
          excluded = localStorage.getItem(KEY) === '1';
        } catch (e) {
          // Storage blocked. Treat as a normal visitor and count it.
        }
        if (excluded) return;

        // Fuente de la visita. Un CV o aplicacion puede enlazar con
        // ?src=<etiqueta> (p.ej. ?src=notion) para saber que documento trajo
        // al visitante. Va al mismo pipeline de clics porque Web Analytics no
        // tiene forma de distinguir origenes: es lo unico que da un conteo
        // exacto y no muestreado.
        (function () {
          var src = params.get('src');
          if (!src || !/^[a-z0-9-]{1,40}$/i.test(src) || !navigator.sendBeacon) return;
          try {
            navigator.sendBeacon(
              '/e',
              JSON.stringify({
                e: 'src:' + src.toLowerCase(),
                p: location.pathname,
                l: document.documentElement.lang,
                r: document.referrer
              })
            );
          } catch (e) {
            // Una fuente que no se registra no puede romper la carga.
          }
        })();

        // Clics. El beacon de Cloudflare solo cuenta visitas, nunca clics, asi
        // que estos van a /e, que el Worker guarda en D1. Un unico listener
        // delegado: los enlaces marcados con data-ev dan su propio nombre y el
        // resto se deduce del href, para que nada quede sin registrar.
        document.addEventListener('click', function (event) {
          var el = event.target;
          if (!el || !el.closest) return;
          var link = el.closest('a');
          if (!link) return;

          var href = link.getAttribute('href');
          if (!href) return;

          var name = link.dataset.ev || derive(href);
          if (!name || !navigator.sendBeacon) return;

          try {
            navigator.sendBeacon(
              '/e',
              JSON.stringify({
                e: name,
                h: href,
                p: location.pathname,
                l: document.documentElement.lang,
                r: document.referrer
              })
            );
          } catch (e) {
            // Un clic que no se registra no puede romper la navegacion.
          }
        });

        function derive(href) {
          if (href.charAt(0) === '#') return 'anchor:' + href.slice(1);
          if (href.indexOf('mailto:') === 0) return 'email';
          try {
            var u = new URL(href, location.href);
            if (u.origin === location.origin) return 'page:' + u.pathname;
            return 'out:' + u.hostname.replace(/^www\./, '');
          } catch (e) {
            return 'link';
          }
        }

        if (!analyticsToken) return;

        var s = document.createElement('script');
        s.defer = true;
        s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        s.setAttribute('data-cf-beacon', JSON.stringify({ token: analyticsToken }));
        document.head.appendChild(s);
      })();
    </script>
  </body>
</html>
